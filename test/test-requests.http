# api http test requests for VSCode
@apiUrl = http://127.0.0.1:3000/api/v1

### get cats
GET {{apiUrl}}/cats
Authorization: Bearer {{login.response.body.token}}

### get cat by id
GET {{apiUrl}}/cats/8

### get cat by id (FAIL: not found)
GET {{apiUrl}}/cats/98

# cat_name, weight, owner, filename, birthdate
### post new cat
POST {{apiUrl}}/cats
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "cat_name": "Rolle",
    "birthdate": "2022-10-10",
    "weight": 4,
    "owner": "Tiina",
    "filename": "https://placecats.com/310/240"
}

### post cat WITH IMAGE
POST http://127.0.0.1:3000/api/v1/cats HTTP/1.1
Content-Type: multipart/form-data; boundary=MyBoundary
Authorization: Bearer {{login.response.body.token}}

--MyBoundary
Content-Disposition: form-data; name="cat_name"

Dogi
--MyBoundary
Content-Disposition: form-data; name="weight"

4
--MyBoundary
Content-Disposition: form-data; name="birthdate"

2022-10-08
--MyBoundary
Content-Disposition: form-data; name="image"; filename="lazypomlogo.png"
Content-Type: image/png

< ./lazypomlogo.png
--MyBoundary--

### post cat MISSING FILE for error testing
POST {{apiUrl}}/cats
Authorization: Bearer {{login.response.body.token}}
Content-Type: multipart/form-data; boundary=MyBoundary

--MyBoundary
Content-Disposition: form-data; name="cat_name"

Dogi
--MyBoundary
Content-Disposition: form-data; name="weight"

4
--MyBoundary
Content-Disposition: form-data; name="birthdate"

2022-10-08
--MyBoundary--

### edit existing cat
PUT {{apiUrl}}/cats/48
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "weight": 6,
    "cat_name": "Uusi nimi"
}

### delete cat by id
DELETE {{apiUrl}}/cats/48
Authorization: Bearer {{login.response.body.token}}

## /users resource
### Register new user
POST {{apiUrl}}/users
Content-Type: application/json

{
    "name": "Johanna",
    "username": "johanna",
    "email": "johanna@example.com",
    "password": "salasana"
}

## /auth resource
### User login
# @name login
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
    "username": "johanna",
    "password": "salasana"
}

### Get my user info
GET http://localhost:3000/api/v1/auth/me
Authorization: Bearer {{login.response.body.token}}

### delete cat by id
DELETE {{apiUrl}}/cats/60
Authorization: Bearer {{login.response.body.token}}

### Update own cat
PUT {{apiUrl}}/cats/41
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
  "cat_name": "Siiri test",
  "weight": 4
}

### Get Johanna's cats
GET {{apiUrl}}/users/38/cats
Authorization: Bearer {{login.response.body.token}}

### Try to update another user's information (should fail)
PUT {{apiUrl}}/users/37
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "name": "Test",
    "username": "test",
    "email": "test@example.com"
}

### Try to delete another user (should fail)
DELETE {{apiUrl}}/users/37
Authorization: Bearer {{login.response.body.token}}

### Olematon reitti
GET http://localhost:3000/ei-ole-olemassa

### Register user with invalid data
POST {{apiUrl}}/users
Content-Type: application/json

{
    "name": "Jo",
    "username": "ab",
    "email": "not-an-email",
    "password": "123"
}

### Try to update own user with invalid username
PUT {{apiUrl}}/users/38
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "username": "ab"
}

### Invalid cat ID
GET {{apiUrl}}/cats/abc

### Invalid user ID
GET {{apiUrl}}/users/abc/cats
Authorization: Bearer {{login.response.body.token}}

### Update cat with empty name
PUT {{apiUrl}}/cats/41
Authorization: Bearer {{login.response.body.token}}
Content-Type: application/json

{
    "cat_name": ""
}

### Login with empty username
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
    "username": "",
    "password": "salasana"
}

### Login with empty password
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
    "username": "johanna",
    "password": "Vääräsaalsana"
}
